    Private Crc32Table As UInteger() = Nothing

    ' 标准 CRC32（反射，poly 0xEDB88320）。上游每次调用都重建表，这里只建一次，结果不变。
    Public Function CRC32(param1 As Byte()) As UInteger
        If Crc32Table Is Nothing Then
            Dim t(255) As UInteger
            For i As Integer = 0 To 255
                Dim c As UInteger = CUInt(i)
                For j As Integer = 1 To 8
                    If (c And 1) = 1 Then
                        c = (c >> 1) Xor &HEDB88320UI
                    Else
                        c >>= 1
                    End If
                Next
                t(i) = c
            Next
            Crc32Table = t
        End If
        Dim v As UInteger = &HFFFFFFFFUI
        For i As Integer = 0 To param1.Length - 1
            v = (v >> 8) Xor Crc32Table(CInt((v And &HFF) Xor param1(i)))
        Next
        Return Not v
    End Function

    ' HW 风格 CRC 的单段增量计算，param2 是上一段的中间值。
    Public Function HW_CTREE_CRC(param1 As Byte(), param2 As UInteger) As UInteger
        Dim v As UInteger = param2
        For i As Integer = 0 To param1.Length - 1
            v = (param1(i) Or (v << 8)) Xor CtreeCrcTable(CInt(v >> 24))
        Next
        For k As Integer = 4 To 1 Step -1
            v = CtreeCrcTable(BitConverter.GetBytes(v)(3)) Xor (v << 8)
        Next
        Return v
    End Function

    ' 分块计算（每块 1024 字节）后返回 4 字节小端结果。
    ' 分块是上游行为：HW_CTREE_CRC 每段都做尾部补零，切分方式不同结果就不同，必须照抄。
    Public Function HW_CTREE_CRC32(param1 As Byte()) As Byte()
        Dim v As UInteger = &H0UI
        Dim pos As Integer = 0
        While param1.Length - pos > 1024
            Dim chunk(1023) As Byte
            Array.Copy(param1, pos, chunk, 0, 1024)
            v = HW_CTREE_CRC(chunk, v)
            pos += 1024
        End While
        Dim tail(param1.Length - pos - 1) As Byte
        Array.Copy(param1, pos, tail, 0, param1.Length - pos)
        v = HW_CTREE_CRC(tail, v)
        Return BitConverter.GetBytes(v)
    End Function

End Module
